APP_NAME="Electricity Monitor"
APP_DEBUG=false
ALLOW_INSECURE_STARTUP=false

SECRET_KEY="REPLACE_WITH_A_RANDOM_SECRET"
CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET"
CREDENTIAL_ENCRYPTION_OLD_KEYS=""
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# The host is the Compose service name, not 127.0.0.1.
DATABASE_URL="postgresql+psycopg://sdu_power:REPLACE_WITH_THE_SAME_DB_PASSWORD@postgres:5432/sdu_power"

CORS_ORIGINS="http://192.0.2.10"
TRUSTED_HOSTS="192.0.2.10"
TRUSTED_PROXY_CIDRS="172.30.0.0/24"
SECURITY_HEADERS_ENABLED=true

ELECTRICITY_API_URL="https://mcard.sdu.edu.cn/charge/feeitem/getThirdData"
ELECTRICITY_API_TYPE="IEC"
ELECTRICITY_API_LEVEL="3"
ELECTRICITY_API_FEEITEMID="410"
ELECTRICITY_API_TIMEOUT=10

HWGL_API_BASE_URL="http://www.hwgl.qd.sdu.edu.cn/lwwaterpower"
HWGL_API_TIMEOUT=10
HWGL_DIRECTORY_CACHE_SECONDS=3600
HWGL_CAMPUS_NAME="山东大学青岛校区"
HWGL_PAY_TYPE="sl"
HWGL_METADATA_SYNC_INTERVAL_SECONDS=86400
HWGL_METADATA_HISTORY_DAYS=30
HWGL_RECHARGE_HISTORY_DAYS=180
HWGL_PROBE_MAX_DURATION_SECONDS=7200

CHECK_INTERVAL_SECONDS=14400
CHECK_BATCH_SIZE=50
CHECK_REQUEST_DELAY_SECONDS=0.5
NOTIFY_INTERVAL_SECONDS=3600
NOTIFY_COOLDOWN_HOURS=12
DEFAULT_ALERT_DAYS=1
DEFAULT_DAILY_USAGE_KWH=5.0
USAGE_HISTORY_DAYS=14
MAX_ROOMS_PER_USER=3

VERIFICATION_CODE_RETENTION_DAYS=1
CHECK_ATTEMPT_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90
ELECTRICITY_READING_RETENTION_DAYS=365
ADMIN_AUDIT_LOG_RETENTION_DAYS=365
SCHEDULED_JOB_RUN_RETENTION_DAYS=90
RETENTION_CLEANUP_HOUR=3

UPLOAD_DIR="/app/uploads"
APPEARANCE_UPLOAD_MAX_BYTES=5242880
MAX_REQUEST_BODY_BYTES=1048576

SMTP_HOST=""
SMTP_PORT=465
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
